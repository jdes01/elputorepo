{
  "extends": "../../../configs/tsconfig.base.json",
  "compilerOptions": {
    // Nest compila a CommonJS: sin "type": "module" en package.json, nodenext emite CJS.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "esnext.temporal"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src",
    "http",
    "e2e",
    "integration",
    "vitest.silence-logs.ts",
    "vitest.config.mts",
    "vitest.http.config.mts",
    "vitest.integration.config.mts",
    "vitest.e2e.config.mts",
    "drizzle.config.ts"
  ]
}
